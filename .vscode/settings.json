{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.vscode/sleap.env",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.windows": {
    "UV_CACHE_DIR": "${workspaceFolder}\\.uv-cache",
    "UV_PYTHON_INSTALL_DIR": "${workspaceFolder}\\.uv-python",
    "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}\\.venv",
    "SLEAP_CONFIG_DIR": "${workspaceFolder}\\.sleap",
    "VIRTUAL_ENV": "${workspaceFolder}\\.venv",
    "PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"
  }
}
